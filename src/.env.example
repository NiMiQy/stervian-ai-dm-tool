# Copy this file to src/.env and fill in your own values.
# src/.env is ignored by git — never commit it.

# MySQL / MariaDB connection
DB_HOST="localhost"
DB_USER="root"
DB_PASSWORD=""
DB_DATABASE="stervian"
DB_URL="mysql://USER:PASSWORD@localhost:3306/stervian"

# Optional server ports (defaults: 3000 for the web app, 3001 for the MCP server)
# PORT=3000
# MCP_PORT=3001

# Optional AI tuning
# AI_MAX_TOKENS=
# AI_CONTEXT_WINDOW_TOKENS=

# The DeepSeek API key is NOT set here.
# Each player enters it in game.html with the "Enter AI API key" button.
