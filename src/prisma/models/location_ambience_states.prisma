model location_ambience_states {
  id              Int          @id @default(autoincrement())
  scope_key       String       @unique @db.VarChar(32)
  location_id     Int
  sublocation_id  Int?
  ambience_id     Int?
  time_slot       TimeSlot
  weather         WeatherType?
  crowd_level     CrowdLevel?
  description     String?      @db.Text
  figures         Json?
  slot_started_at DateTime     @db.DateTime(0)
  created_at      DateTime?    @default(now()) @db.DateTime(0)
  updated_at      DateTime?    @updatedAt @db.DateTime(0)

  location    locations     @relation(fields: [location_id], references: [id], onDelete: Cascade)
  sublocation sublocations? @relation(fields: [sublocation_id], references: [id], onDelete: Cascade)

  @@index([location_id])
}
