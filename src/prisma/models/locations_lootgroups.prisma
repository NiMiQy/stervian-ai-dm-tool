model locations_lootgroups {
  id            Int  @id @default(autoincrement())
  location_id   Int?
  loot_group_id Int?

  chance_pct    Float?  @default(100)

  created_at DateTime? @default(now()) @db.DateTime(0)
  updated_at DateTime? @updatedAt @db.DateTime(0)
  deleted    Boolean?  @default(false)

  locations   locations?   @relation(fields: [location_id], references: [id])
  loot_groups loot_groups? @relation(fields: [loot_group_id], references: [id])

  @@index([location_id], map: "locations_lootgroups_location_id_fkey")
  @@index([loot_group_id], map: "locations_lootgroups_loot_group_id_fkey")
}
