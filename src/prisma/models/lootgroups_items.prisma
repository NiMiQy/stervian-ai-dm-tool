model lootgroups_items {
  id            Int  @id @default(autoincrement())
  loot_group_id Int?
  item_id       Int?

  chance_pct   Float @default(0.0)
  min_quantity Int   @default(1)
  max_quantity Int   @default(5)

  created_at DateTime? @default(now()) @db.DateTime(0)
  updated_at DateTime? @updatedAt @db.DateTime(0)
  deleted    Boolean?  @default(false)

  // Relations
  loot_groups loot_groups? @relation(fields: [loot_group_id], references: [id])
  items       items?       @relation(fields: [item_id], references: [id])

  @@index([loot_group_id], map: "lootgroups_items_loot_group_id_fkey")
  @@index([item_id], map: "lootgroups_items_item_id_fkey")
}
