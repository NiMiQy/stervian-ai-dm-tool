model npc_known_locations {
  id             Int  @id @default(autoincrement())
  character_id   Int
  location_id    Int?
  sublocation_id Int?

  location_knowledge_type NpcLocationKnowledge @default(LOCAL_LANDMARK)
  location_semantic_memory String? @db.Text // Facts & knowledge

  created_at DateTime? @default(now()) @db.DateTime(0)
  updated_at DateTime? @updatedAt @db.DateTime(0)
  deleted    Boolean?  @default(false)

  npc         npcs          @relation("CharacterKnownLocations", fields: [character_id], references: [character_id], onDelete: Cascade)
  location    locations?    @relation(fields: [location_id], references: [id], onDelete: Cascade)
  sublocation sublocations? @relation(fields: [sublocation_id], references: [id], onDelete: Cascade)

  @@index([character_id], map: "npc_known_loc_char_idx")
  @@index([location_id], map: "npc_known_loc_loc_idx")
  @@index([sublocation_id], map: "npc_known_loc_subloc_idx")
}
